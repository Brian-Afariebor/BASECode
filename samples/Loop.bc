/**
Program Loop:
    
    Description:
        A program that iterates 100 times.

    Preconditions:
        None.

    Result:
        Runs 100 iterations of a loop.

    Postconditions:
        The code is ended.
*/


/**
Function Loop::Loop:

    Description:
        Runs an iteration of the song loop.

    Preconditions:
        Loop::LoopStart is not null.

    Result:
        If the next iteration exists,
            runs it.

    Postconditions:
        If Loop::LoopStart is 0,
            function::Loop::End is jumped to.
        
        Otherwise,
            function::Loop::Loop is jumped to. 
*/
fn Loop::Loop
{
    if(Loop::LoopStart == 0)
    {
        del(Loop::LoopStart);
        jmp(function::Loop::End);
    }
    else
    {
        // Do what you want here
        set Loop::LoopStart = add(Loop::LoopStart,-1);        
        jmp(function::Loop::Loop);
    }
}


/**
Function Loop::End:

    Description:
        Ends the loop.
        
    Preconditions:
        None.
        
    Result:
        The current thread ends.
        
    Postconditions:
        The current thread is ended.

*/
fn Loop::End
{   
    end(0);
}


/**
Main Loop::Main:

    Description:
        Starts the loop.
        
    Preconditions:
        None.
        
    Result:
        The loop is jumped to.
        
    Postconditions:
        Loop::LoopStart is initialized to 100,
            and function::Loop::Loop is jumped to.
*/
mn Loop::Main
{
    set Loop::LoopStart = 100;
    jmp(function::Loop::Loop);
}